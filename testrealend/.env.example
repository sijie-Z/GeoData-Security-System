# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Default password for new employees (change after first login)
DEFAULT_EMPLOYEE_PASSWORD=changeme123

# Database Configuration
MYSQL_URI=mysql+mysqldb://user:password@host:port/database
POSTGRES_URI=postgresql://user:password@host:port/database

# QR Watermark Signature Key (required for production)
QR_SECRET_KEY=your-qr-secret-key-change-in-production

# File Storage Paths (absolute or relative to project root)
UPLOAD_FOLDER=./uploads
WATERMARK_FOLDER=./watermarks
EXTRACTED_FOLDER=./extracted

# AI Assistant — works with any OpenAI-compatible chat API.
# Defaults: AI_API_BASE=https://api.deepseek.com, AI_MODEL=deepseek-chat.
# AI_API_KEY takes priority; legacy DEEPSEEK_API_KEY is used as fallback.
# AI_TIMEOUT is the request timeout in seconds (default 120): local models
# may need much longer on their first (cold-start) call — tune per endpoint.
# AI_API_KEY=sk-your-key
# AI_TIMEOUT=120
# Local example (Ollama):
#   AI_API_BASE=http://localhost:11434/v1
#   AI_MODEL=qwen2.5
#   AI_API_KEY=ollama
