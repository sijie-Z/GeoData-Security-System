# docker-compose.yml 环境变量模板（与 compose 引用一一对应，共 9 项）
#
# 用法：复制本文件为 .env 并填写所有「必填」项——
#   cp .env.example .env
# 密钥类变量在缺失或为空时，docker compose 会直接报错并提示变量名，
# 不会再回退到任何内置默认口令（此类默认值已全部从 docker-compose.yml 移除）。
# 非密钥默认值（库名 / 用户名）保留在 compose 内，可留空不填。

# ── MySQL（业务库） ──────────────────────────────────────────
# 必填：MySQL root 密码
MYSQL_ROOT_PASSWORD=
# 可选（默认 esri_test）
MYSQL_DATABASE=esri_test

# ── PostgreSQL + PostGIS（空间库） ───────────────────────────
# 可选（默认 postgres）
POSTGRES_USER=postgres
# 必填：Postgres 密码
POSTGRES_PASSWORD=
# 可选（默认 esri_test）
POSTGRES_DB=esri_test

# ── Flask 后端 ───────────────────────────────────────────────
# 必填：Flask session 签名密钥
# （本地直接 `python app.py` 且未设置时，后端会生成临时随机密钥并打印 WARNING；重启后旧令牌失效）
SECRET_KEY=
# 必填：JWT 签名密钥
JWT_SECRET_KEY=

# ── Grafana ─────────────────────────────────────────────────
# 可选（默认 admin）
GRAFANA_USER=admin
# 必填：Grafana admin 密码
GRAFANA_PASSWORD=
